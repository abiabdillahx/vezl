# Copy to /etc/vezl/vezl.env and chmod 600 — it holds secrets.
PORT=3000
DATABASE_PATH=/var/lib/vezl/vezl.db
GEO_DB_PATH=/var/lib/vezl/geo.mmdb

SESSION_SECRET=change-me-min-32-chars-please
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

GIN_MODE=release
GOMEMLIMIT=100MiB
